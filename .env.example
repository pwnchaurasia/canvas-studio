# Copy to /opt/canvas-studio/web_app/.env on the Droplet (chmod 600). Never commit the real file.

# Session signing key, >= 32 chars:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Invite-only accounts: user:password pairs, comma separated. Usernames: lowercase a-z, 0-9, -
ALLOWED_USERS=u1:change-me-1,u2:change-me-2,u3:change-me-3

# Modal GPU worker (printed by `modal deploy`, no trailing slash), e.g. https://<workspace>--canvas-studio-worker-web.modal.run
MODAL_ENDPOINT_URL=
# Must equal STUDIO_API_KEY in the Modal secret "canvas-studio-secrets"
STUDIO_API_KEY=
# Modal proxy auth token (Modal dashboard -> Settings -> Proxy Auth Tokens). Blocks unauthenticated GPU wake-ups.
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Optional OpenAI-compatible LLM for Chat + prompt optimizer (leave blank to disable; optimizer falls back to rules)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ENHANCER_MODEL=

# Monthly GPU budget across all users, in minutes. Modal $30 credit / $0.000222 per s ≈ 2250 min on L4.
MONTHLY_GPU_MINUTES_CAP=1800

# 1 behind ngrok (HTTPS). Set 0 only for local http testing.
COOKIE_SECURE=1
